DB_HOST=localhost
DB_PORT=5432
DB_NAME=escuela_db
DB_USER=postgres
DB_PASSWORD=

# Ejemplo seguro de DATABASE_URL (reemplaza los valores antes de usar)
# No pongas comandos aquí — solo la URL de conexión
# Ejemplo: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=postgresql://postgres:TU_PASSWORD@containers-us-west-XX.railway.app:5432/railway


# Nota: para ejecutar el seed, usa la CLI o un comando one-off en Railway:
#   node servidor/seed-db.js

# Última actualización: 2026-08-24 — añadida instrucción para inicializar DB desde Railway
